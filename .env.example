# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase → Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "Publishable key" (starts with sb_publishable_). Safe to show in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (starts with sb_secret_). Server only. Bypasses all security rules.
SUPABASE_SECRET_KEY=

# Supabase → Connect → "Session pooler" connection string, with your database password filled in.
# Used only by migrations, the seed script and the database security tests. Never by the app.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Public address of the app. Used in email links (invites, password reset).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Password for the demo accounts created by `npm run db:seed`. Pick any long random string.
SEED_DEMO_PASSWORD=
